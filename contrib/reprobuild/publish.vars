# Where a release is published.  Data, not secrets: the bucket is public-read,
# and the credentials that write it never appear here (see below).
#
# The bucket is configured for public read of exact keys with *listing
# refused*, and object versioning is off on purpose -- see the key layout
# below for what that means for the driver.

# The public base URL a downloader resolves an artifact at, and what the
# release notes and manifest links print.  No custom domain fronts the bucket;
# moving to one later would leave earlier releases' links on this host.
PUBLISH_BASE_URL=https://storage.googleapis.com/cln-releases

# The S3-compatible endpoint and bucket that `publish` uploads to.  GCS speaks
# S3 through its interoperability API, so one client (rclone, s3 backend,
# provider=GCS) covers it.
REPRO_S3_ENDPOINT=https://storage.googleapis.com
REPRO_S3_BUCKET=cln-releases
REPRO_S3_PROVIDER=GCS

# Key layout.  Release artifacts go to `<ver>/<file>`, one-to-one with the
# staging dir `release/publish/<ver>/`; `publish` refuses to overwrite an
# existing `<ver>/` prefix, because with versioning off immutability has to be
# a driver rule.
#
# The source archive gets its own prefix: `certify` `nix copy`s the
# fixed-output source paths there and it is served as a plain Nix binary cache
# (`nix-cache-info` at its root), listed ahead of cache.nixos.org in the
# substituter list the driver passes.  Co-signers read it **anonymously** --
# content-addressed paths are verified by hash, so it needs no signing key and
# no credentials.
PUBLISH_PREFIX_ARCHIVE=nix-cache

# Credentials: the HMAC key of one shared publisher account, kept in the team's
# password manager and shared with every captain.  Sourced into the environment
# as REPRO_S3_ACCESS_KEY_ID / REPRO_S3_SECRET_ACCESS_KEY for the length of the
# command and never written to disk.  That account cannot write under `debug/`,
# so the unstripped binaries and symbol files cannot be published even by a
# driver bug: the bucket refuses them, not just the staging rule.
