# Where a release is published at T0.  Data, not
# secrets: the bucket is public-read, and the credentials that write it never
# appear here (see below).
#
# The bucket was provisioned by DevOps on 2026-09-07 (tasks#3615): GCS
# `cln-releases` in project `c-lightning`, US multi-region, uniform
# bucket-level access, versioning off, public read of exact keys with
# *listing refused* (`roles/storage.legacyObjectReader` for allUsers, which
# unlike `objectViewer` carries no `storage.objects.list`).

# The public base URL a downloader resolves an artifact at, and what the
# release notes and manifest links print.  No custom domain fronts the
# bucket (decided 2026-09-21); moving to one later would leave earlier
# releases' links on this host.
PUBLISH_BASE_URL=https://storage.googleapis.com/cln-releases

# The S3-compatible endpoint and bucket that `publish` uploads to.  GCS
# speaks S3 through its interoperability API, so one client (rclone, s3
# backend, provider=GCS) covers it.
REPRO_S3_ENDPOINT=https://storage.googleapis.com
REPRO_S3_BUCKET=cln-releases
REPRO_S3_PROVIDER=GCS

# Key layout.  Release artifacts go to `<ver>/<file>`, one-to-one with the
# staging dir `release/publish/<ver>/`; `publish` refuses to overwrite an
# existing `<ver>/` prefix, because immutability is a driver rule here
# (object versioning is off on purpose).
#
# The source archive gets its own prefix: `certify` `nix copy`s the
# fixed-output source paths there and it is served as a plain Nix binary
# cache (`nix-cache-info` at its root), listed ahead of cache.nixos.org in
# the substituter list the driver passes.  Co-signers read it
# **anonymously** -- content-addressed paths are verified by hash, so it
# needs no signing key and no credentials.
PUBLISH_PREFIX_ARCHIVE=nix-cache

# Credentials: one shared GCS service account, HMAC key in the "Core
# Lightning Admin" 1Password vault, item "GCS release bucket -
# cln-releases", shared with every captain by vault membership.  Sourced
# into the environment as REPRO_S3_ACCESS_KEY_ID / REPRO_S3_SECRET_ACCESS_KEY
# for the length of the command and never written to disk.  The account's
# IAM binding is bucket-scoped and denies writes under `debug/`, so the
# unstripped binaries and symbol files cannot be published even by a driver
# bug -- the bucket refuses them, not just the staging rule.
