{
  "$schema": "../rpc-schema-draft.json",
  "type": "object",
  "rpc": "askrene-constraint-channel",
  "title": "Command to add channel capacity restrictions to layer",
  "added": "v26.12",
  "description": [
    "The **askrene-constraint-channel** RPC command adds constraints on the channel's liquidity.  An upper constraint tells askrene that the liquidity available for use must not be greater than the value provided.  A lower constraint tells askrene that the provided value can be routed with 100% certainty."
  ],
  "request": {
    "required": [
      "layer",
      "short_channel_id_dir",
      "amount_msat",
      "upper"
    ],
    "additionalProperties": false,
    "properties": {
      "layer": {
        "type": "string",
        "description": [
          "The name of the layer to apply this change to."
        ]
      },
      "short_channel_id_dir": {
        "type": "short_channel_id_dir",
        "description": [
          "The short channel id and direction to apply this change to."
        ]
      },
      "amount_msat": {
        "type": "msat",
        "description": [
          "The amount we set as an upper or lower constraint."
        ]
      },
      "upper": {
        "type": "bool",
        "default": true,
        "description": [
          "Whether this constraint is an upper or a lower value."
        ]
      }
    }
  },
  "response": {
    "required": [
      "constraints"
    ],
    "additionalProperties": false,
    "properties": {
      "constraints": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "layer",
            "short_channel_id_dir",
            "timestamp"
          ],
          "additionalProperties": false,
          "properties": {
            "short_channel_id_dir": {
              "type": "short_channel_id_dir",
              "description": [
                "The short channel id and direction"
              ]
            },
            "layer": {
              "type": "string",
              "description": [
                "The name of the layer to apply this change to."
              ]
            },
            "timestamp": {
              "type": "u64",
              "description": [
                "The UNIX timestamp when this constraint was created."
              ]
            },
            "maximum_msat": {
              "type": "msat",
              "description": [
                "The maximum value which this channel could pass."
              ]
            },
            "minimum_msat": {
              "type": "msat",
              "description": [
                "The minimum value which this channel can pass with 100% certainty."
              ]
            }
          }
        }
      }
    }
  },
  "see_also": [
    "lightning-getroutes(7)",
    "lightning-channel-observation(7)",
    "lightning-askrene-disable-node(7)",
    "lightning-askrene-create-channel(7)",
    "lightning-askrene-listlayers(7)",
    "lightning-askrene-age(7)"
  ],
  "author": [
    "Lagrang3 [lagrang3@protonmail.com](mailto:lagrang3@protonmail.com) is mainly responsible."
  ],
  "resources": [
    "Main web site: [https://github.com/ElementsProject/lightning](https://github.com/ElementsProject/lightning)"
  ],
  "examples": [
  ]
}
