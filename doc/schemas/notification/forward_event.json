{
  "$schema": "../../rpc-schema-draft.json",
  "type": "object",
  "additionalProperties": false,
  "notification": "forward_event",
  "title": "Notification for forwarding events",
  "description": [
    "The **forward_event** notification informs whenever the status of a forwarded HTLC changes."
  ],
  "added": "pre-v0.10.1",
  "request": {},
  "response": {
    "required": [
      "payment_hash",
      "in_channel",
      "in_msat",
      "status",
      "received_time"
    ],
    "properties": {
      "payment_hash": {
        "type": "hash",
        "description": [
          "The payment hash for the forwarded HTLC."
        ]
      },
      "in_channel": {
        "type": "short_channel_id",
        "description": [
          "The inbound channel that received the HTLC."
        ]
      },
      "out_channel": {
        "type": "short_channel_id",
        "description": [
          "The outbound channel used for the forward, if one was selected."
        ]
      },
      "in_msat": {
        "type": "msat",
        "description": [
          "The amount of the incoming HTLC."
        ]
      },
      "out_msat": {
        "type": "msat",
        "description": [
          "The amount forwarded to the outbound channel, if known."
        ]
      },
      "fee_msat": {
        "type": "msat",
        "description": [
          "The fee earned on the forward, if an outbound amount is known."
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "offered",
          "settled",
          "local_failed",
          "failed"
        ],
        "description": [
          "The current forwarding status."
        ]
      },
      "failcode": {
        "type": "u32",
        "description": [
          "The BOLT 4 failcode when the forward failed locally."
        ]
      },
      "failreason": {
        "type": "string",
        "description": [
          "The symbolic failcode name when the forward failed locally."
        ]
      },
      "failure_reason": {
        "type": "string",
        "added": "v26.12",
        "enum": [
          "insufficient_outgoing_liquidity",
          "too_many_htlcs",
          "dust_limit",
          "htlc_below_minimum",
          "htlc_above_maximum",
          "fee_insufficient",
          "cltv_incorrect",
          "cltv_expiry_too_soon",
          "cltv_expiry_too_far",
          "unknown_next_peer",
          "outgoing_peer_offline",
          "channel_failed_permanent",
          "invalid_onion",
          "channel_shutting_down",
          "max_htlc_value_in_flight",
          "peer_cannot_afford_fee"
        ],
        "description": [
          "The root cause of the failure, more specific than *failcode*/*failreason*. Only set for *local_failed* forwards, and not always known.",
          "*insufficient_outgoing_liquidity* means our own spendable balance on the outgoing channel was too low; *peer_cannot_afford_fee* means the peer opened the outgoing channel and cannot pay the commitment fee for another HTLC."
        ]
      },
      "style": {
        "type": "string",
        "enum": [
          "legacy",
          "tlv"
        ],
        "description": [
          "The onion format used for the forward, if known."
        ],
        "added": "v23.11"
      },
      "received_time": {
        "type": "number",
        "description": [
          "The UNIX timestamp when the HTLC was received."
        ]
      },
      "resolved_time": {
        "type": "number",
        "description": [
          "The UNIX timestamp when the HTLC was resolved, if it has been resolved."
        ]
      }
    }
  }
}
